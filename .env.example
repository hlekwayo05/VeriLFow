# Local Postgres (default)
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/veriflow

# Supabase (Project Settings → Database → Connection string)
# Prefer Session mode pooler for this long-lived Express API (IPv4-friendly):
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Direct host db.<ref>.supabase.co is IPv6-only on many networks.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Storage (use the service_role key, not the anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Optional pool tuning (defaults shown)
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000

# Generate with: openssl rand -hex 32
# Must be at least 32 characters for production
JWT_SECRET=replace_with_64_char_random_string_eg_openssl_rand_hex_32

# Password for the seeded admin account
# Change this before running seed in production
ADMIN_SEED_PASSWORD=change_this_before_seeding

PORT=3000
RESEND_API_KEY=re_your_resend_api_key
# Test sender (Resend sandbox): only delivers to your Resend account email.
# For real @ump.ac.za delivery, verify your domain at resend.com and use e.g.:
# RESEND_FROM_EMAIL=onboarding@ump.ac.za
RESEND_FROM_EMAIL=onboarding@resend.dev
# Development only - redirects all emails to this
# address (Resend free tier restriction).
# Remove or leave blank in production.
EMAIL_OVERRIDE=your_registered_resend_email@example.com
PORTAL_URL=http://localhost:5500/frontend/pages/apply-step1.html
FRONTEND_URL=http://192.168.x.x:5500/frontend
# Comma-separated allowed browser origins (no trailing slash)
# Local dev often needs both localhost and 127.0.0.1
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://yourdomain.com
